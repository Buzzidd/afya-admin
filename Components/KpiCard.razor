@Titulo
    @Valor
    


@code {
    [Parameter] public string Titulo { get; set; } = string.Empty;
    [Parameter] public string Valor { get; set; } = string.Empty;
    [Parameter] public string Cor { get; set; } = string.Empty;
    [Parameter] public double[] DadosGrafico { get; set; } = Array.Empty();

    private Color CorLine => Cor switch
    {
        "mud-theme-primary" => Color.Primary,
        "mud-theme-success" => Color.Success,
        "mud-theme-error" => Color.Error,
        "mud-theme-warning" => Color.Warning,
        _ => Color.Default
    };
}