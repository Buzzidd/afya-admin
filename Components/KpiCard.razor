<MudPaper Class="pa-4" Elevation="1">
    <MudStack Spacing="1">
        <MudText Typo="Typo.body2" Color="Color.Secondary">@Titulo</MudText>
        <MudText Typo="Typo.h5">@Valor</MudText>
        <MudChart T="double" ChartType="ChartType.Line" ChartSeries="@Series" Width="100%" Height="50px" DisableLegend="true" />
    </MudStack>
</MudPaper>

@code {
    [Parameter] public string Titulo { get; set; } = string.Empty;
    [Parameter] public string Valor { get; set; } = string.Empty;
    [Parameter] public string Cor { get; set; } = string.Empty;
    [Parameter] public double[] DadosGrafico { get; set; } = Array.Empty<double>();

    private List<ChartSeries<double>> Series => new()
    {
        new ChartSeries<double>() { Name = "Evolução", Data = DadosGrafico }
    };
}